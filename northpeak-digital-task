        }

        section{
            padding:60px 20px;
        }

        .card,
        .testimonial,
        .price-card{
            padding:25px;
        }

        .price-card h1{
            font-size:34px;
        }

        .btn{
            width:100%;
            text-align:center;
        }

        }

