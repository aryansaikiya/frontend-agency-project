</nav>

<section id="home" class="hero">

    <div class="hero-text">

        <h1>
            We Help Businesses Grow Online
        </h1>

        <p>

            NorthPeak Digital builds modern websites,
            improves SEO, and creates marketing strategies
            that generate measurable business growth.

        </p>

        <a href="#contact" class="btn">
            Start Your Project
        </a>

    </div>

    <div class="hero-image">

        <img
        src="https://images.unsplash.com/photo-1552664730-d307ca884978?w=900"
        alt="Business Meeting">

    </div>

</section>

<section id="services">

    <h2 class="section-title">
        Our Services
    </h2>

    <div class="services-grid">

        <div class="card">
            <h3>Website Design</h3>
            <p>Modern responsive websites that convert visitors into customers.</p>
        </div>

        <div class="card">
            <h3>Web Development</h3>
            <p>Fast, secure and scalable websites using modern technologies.</p>
        </div>

        <div class="card">
            <h3>SEO</h3>
            <p>Improve Google rankings and drive more organic traffic.</p>
        </div>

        <div class="card">
            <h3>Digital Marketing</h3>
            <p>Targeted campaigns that increase leads and sales.</p>
        </div>

        <div class="card">
            <h3>Brand Identity</h3>
            <p>Create a memorable visual identity for your business.</p>
        </div>

        <div class="card">
            <h3>Analytics</h3>
            <p>Measure performance with detailed business insights.</p>
        </div>

    </div>

</section>

<section id="testimonials">

    <h2 class="section-title">
        Results That Speak
    </h2>

    <div class="testimonial-grid">

        <div class="testimonial">

            ⭐⭐⭐⭐⭐

            <p>

                "NorthPeak increased our online sales
                by 140% in only four months."

            </p>

            <h4>- Emily Carter</h4>

        </div>

        <div class="testimonial">

            ⭐⭐⭐⭐⭐

            <p>

                "Professional team with outstanding
                communication and support."

            </p>

            <h4>- Michael Brown</h4>

        </div>

        <div class="testimonial">

            ⭐⭐⭐⭐⭐

            <p>

                "Our website traffic doubled after
                working with NorthPeak."

            </p>

            <h4>- Sarah Wilson</h4>

        </div>

    </div>

</section>
