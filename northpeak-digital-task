    <style>
        body{
        background:#f8fafc;
        color:#333;
        line-height:1.6;
        }


        .navbar{
            position:sticky;
            top:0;
            z-index:1000;
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:18px 8%;
            background:#ffffff;
            box-shadow:0 3px 10px rgba(0,0,0,.08);
        }

        .logo{
            font-size:1.5rem;
            font-weight:700;
            color:#2563eb;
        }

        .nav-links{
            display:flex;
            list-style:none;
            gap:30px;
        }

        .nav-links a{
            text-decoration:none;
            color:#333;
            font-weight:500;
            transition:.3s;
        }

        .nav-links a:hover{
            color:#2563eb;
        }

        .menu-btn{
            display:none;
            font-size:30px;
            cursor:pointer;
        }

    

        .hero{
            display:grid;
            grid-template-columns:repeat(2,1fr);
            gap:50px;
            align-items:center;
            padding:80px 8%;
        }

        .hero-text h1{
            font-size:3.3rem;
            color:#1e293b;
            margin-bottom:20px;
        }

        .hero-text p{
            color:#555;
            margin-bottom:30px;
        }

        .hero-image img{
            width:100%;
            border-radius:15px;
            box-shadow:0 15px 35px rgba(0,0,0,.15);
        }

        .btn{
            display:inline-block;
            padding:14px 30px;
            background:#2563eb;
            color:#fff;
            text-decoration:none;
            border-radius:30px;
            transition:.3s;
        }

        .btn:hover{
            background:#1d4ed8;
            transform:translateY(-3px);
        }


        section{
            padding:80px 8%;
        }

        .section-title{
            text-align:center;
            margin-bottom:45px;
            font-size:2.3rem;
            color:#1e293b;
        }


        .services-grid{
            display:grid;
            grid-template-columns:repeat(3,1fr);
            gap:25px;
        }

        .card{
            background:#fff;
            padding:30px;
            border-radius:12px;
            text-align:center;
            box-shadow:0 8px 25px rgba(0,0,0,.08);
            transition:.3s;
        }

        .card:hover{
            transform:translateY(-8px);
        }

        .card h3{
            color:#2563eb;
            margin-bottom:15px;
        }


        .testimonial-grid{
            display:grid;
            grid-template-columns:repeat(3,1fr);
            gap:25px;
        }

        .testimonial{
            background:white;
            padding:30px;
            border-radius:12px;
            box-shadow:0 8px 20px rgba(0,0,0,.08);
        }

        .testimonial p{
            margin:18px 0;
        }

       

        .pricing-grid{
            display:grid;
            grid-template-columns:repeat(3,1fr);
            gap:30px;
        }

        .price-card{
            background:white;
            text-align:center;
            padding:35px;
            border-radius:15px;
            box-shadow:0 8px 25px rgba(0,0,0,.08);
            transition:.3s;
        }

        .price-card:hover{
            transform:translateY(-8px);
        }

        .featured{
            background:#2563eb;
            color:white;
            transform:scale(1.05);
        }

        .featured button{
            background:white;
            color:#2563eb;
        }

        .price-card h1{
            margin:20px 0;
            font-size:42px;
        }

        .price-card ul{
            list-style:none;
            margin:25px 0;
        }

        .price-card li{
            margin:10px 0;
        }

        .price-card button{
            padding:12px 28px;
            border:none;
            border-radius:30px;
            background:#2563eb;
            color:white;
            cursor:pointer;
            transition:.3s;
        }

        .price-card button:hover{
            opacity:.9;
        }



        form{
            max-width:650px;
            margin:auto;
            background:white;
            padding:35px;
            border-radius:15px;
            box-shadow:0 8px 25px rgba(0,0,0,.08);
        }

        input,
        textarea{
            width:100%;
            padding:14px;
            margin:12px 0;
            border:1px solid #ddd;
            border-radius:8px;
            font-size:16px;
        }

        textarea{
            resize:vertical;
        }

        form button{
            width:100%;
            padding:15px;
            background:#2563eb;
            color:white;
            border:none;
            border-radius:8px;
            cursor:pointer;
            font-size:17px;
        }

        form button:hover{
            background:#1d4ed8;
        }

        #error{
            margin-top:12px;
            color:red;
            text-align:center;
        }


        footer{
            background:#0f172a;
            color:white;
            text-align:center;
            padding:40px 20px;
        }

        footer h3{
            margin-bottom:10px;
        }


        @media(max-width:768px){

        .hero{
            grid-template-columns:1fr;
            text-align:center;
        }

        .hero-text h1{
            font-size:2.4rem;
        }

        .services-grid,
        .testimonial-grid,
        .pricing-grid{
            grid-template-columns:1fr;
        }

        .nav-links{
            display:none;
        }

        .menu-btn{
            display:block;
        }

        }


